<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PHASE" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/phase_light_a</item>
        <item name="colorPrimaryVariant">@color/phase_dark_a</item>
        <item name="colorOnPrimary">@color/void_black</item>
        <item name="colorSecondary">@color/phase_dark_b</item>
        <item name="colorOnSecondary">@color/void_black</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/void_black</item>
        <item name="android:windowBackground">@color/void_black</item>
    </style>

    <style name="Theme.PHASE.Fullscreen" parent="Theme.PHASE">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/void_black</item>
    </style>
</resources>
